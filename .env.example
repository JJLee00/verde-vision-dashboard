# Verde Vision dashboard — environment variables.
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is
# checked in and must never hold a real value.
#
# Next.js reads .env.local at BOOT ONLY — restart the dev server after any
# change here or it will keep serving the old values.

# ── Supabase ──────────────────────────────────────────────────────────────
# Settings → Data API (URL) and Settings → API Keys (both keys).

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable/anon key. Ships to the browser by design — every table it can
# reach is protected by RLS, so this one is safe to expose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key — BYPASSES RLS and can call auth.admin.*. Server-side only
# (src/lib/supabase/admin.ts); never import that client from a component
# that runs in the browser.
#
# The variable keeps the old "service role" name, but take the key from the
# "Publishable and secret API keys" tab, not the Legacy one: an sb_secret_
# key does the same job and can be rotated and revoked on its own.
SUPABASE_SERVICE_ROLE_KEY=

# ── Vision Pro ingest ─────────────────────────────────────────────────────
# Shared secret the headset sends as `x-api-key` on /api/vision-pro and
# /api/blueprint. Must match DashboardSecrets.swift in the app repo — change
# it in one place and the headset stops syncing.
VISION_PRO_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Google Solar API (aerial imagery + DSM for Auto Blueprint). Unused on main
# — only src/lib/blueprint/solar.ts on the auto-blueprint-footprint branch
# reads it. Leave unset unless you're working on that branch. Restrict the
# key to the Solar API in the GCP console.
GOOGLE_SOLAR_API_KEY=
